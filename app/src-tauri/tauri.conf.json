{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audiora",
  "version": "0.3.0",
  "identifier": "digital.roujan.audiora",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Audiora",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ws://127.0.0.1:7879 ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Roujan Digital Agency",
    "copyright": "© Roujan Digital Agency",
    "category": "Music",
    "shortDescription": "Professional audio mixer and recorder",
    "longDescription": "Audiora by Roujan Digital Agency: a per-app audio mixer with Game, Chat, Media, Aux and Music channels, a studio-grade voice processor and a multitrack recorder for Windows.",
    "homepage": "https://github.com/Roujanm/Audiora",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "startMenuFolder": "Roujan Digital Agency",
        "languages": ["English", "Turkish"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerHooks": "installer/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/audiora-svc"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2QTc4NzQyQTgyMEMzM0YKUldRL3d5Q29Rb2VuaHVibEduV21vc2hmNDNyOStGR2ZTQkhrNGIyb0h3L0czSXNvQjJIUzF2eGIK",
      "endpoints": [
        "https://github.com/Roujanm/Audiora/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
